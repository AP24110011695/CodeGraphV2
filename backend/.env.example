# =============================================================================
# CodeGraph v2 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All settings have sensible defaults for local development.

# --- Database ---
# PostgreSQL async DSN (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codegraph

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=change-me-in-production

# --- LLM Provider ---
# Supported: openai, anthropic, groq
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o

# --- Embedding Provider (independent of LLM provider) ---
# Supported: openai, anthropic, groq, custom
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Authentication ---
# When false (default), X-API-Key header is accepted but not enforced.
# Set to true for hosted/production deployments.
REQUIRE_AUTH=false
REQUIRE_AUTH_FOR_READS=false
# Optional one-time bootstrap key. It is stored hashed on first startup when
# no API keys exist; do not use a placeholder value in a deployed environment.
ADMIN_API_KEY=

# --- Repository Limits ---
MAX_REPO_SIZE_MB=500

# --- Storage ---
UPLOAD_DIR=./uploads

# --- Application ---
# Supported: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=info

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
